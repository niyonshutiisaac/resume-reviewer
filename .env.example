# Google Gemini API key — https://aistudio.google.com/apikey
# Leave this blank to run the app in local analysis mode.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
# If this model is overloaded or unavailable, Merit retries with other Flash
# models before falling back to local analysis.
GEMINI_MODEL=gemini-3.8-flash
